#!/bin/sh
# Hearth (RT8) bring-up: install a key-only root SSH service and two Android
# init overrides from /hearth-provision into the rootfs before it boots.
#
# Runs in local-bottom: by then Halium has loaded the kernel modules (the
# UFS driver is one, so userdata doesn't exist any earlier), mounted
# userdata and moved the rootfs image to ${rootmnt}, mounted read-only.
# Remount it read-write briefly, install, and put it back. Never fails the
# boot.
#
# The UBports test image only enables SSH through an Upstart file, which
# systemd (24.04) ignores. Ubuntu Touch's own USB tethering provides the
# network (tablet at 10.15.19.82).
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in prereqs) prereqs; exit 0;; esac

say() { echo "hearth: $*" > /dev/kmsg; }
SRC=/hearth-provision
ROOT=${rootmnt:-/root}

say "provision: start (root $ROOT)"
[ -d "$SRC" ] || { say "provision: $SRC missing"; exit 0; }
[ -d "$ROOT/usr/lib/systemd/system" ] || { say "provision: no systemd rootfs at $ROOT"; exit 0; }

was_ro=""
if grep -q " $ROOT [^ ]* ro[, ]" /proc/mounts; then
	was_ro=1
	mount -o remount,rw "$ROOT" 2>/dev/null || { say "provision: cannot remount $ROOT rw"; exit 0; }
fi

w="$ROOT/usr/lib/systemd/system"
# Remove the earlier unauthenticated shell and USB-network service if a
# previous build installed them.
rm -f "$w/hearth-usbnet.service" "$w/hearth-shell.socket" "$w/hearth-shell@.service" \
	"$w/multi-user.target.wants/hearth-usbnet.service" \
	"$w/sockets.target.wants/hearth-shell.socket"
rm -rf "$ROOT/usr/libexec/hearth"

# Copy file by file (never cp -a the tree: that would stamp the build user's
# IDs and modes onto existing system directories like /usr, /var). All files
# are root-owned and read-only for others; sshd also refuses key files that
# aren't.
put() { # put <relative path>
	mkdir -p "$ROOT/$(dirname "$1")"
	cat "$SRC/$1" > "$ROOT/$1"
	chown 0:0 "$ROOT/$1"
	chmod 644 "$ROOT/$1"
}
mkdir -p "$ROOT/usr/share/hearth"
chown 0:0 "$ROOT/usr/share/hearth"
chmod 755 "$ROOT/usr/share/hearth"
put usr/share/hearth/authorized_keys
put usr/lib/systemd/system/hearth-sshd.service
put usr/share/hearth/android/vold.rc
put usr/share/hearth/android/vndservicemanager.rc
put usr/share/hearth/android/init.boringssl.zygote64_32.rc
put usr/lib/systemd/system/lxc-android-config-mount-apexes.service.d/hearth-all-apexes.conf
put usr/lib/systemd/system/hearth-vndk-apex.service
put usr/libexec/hearth/vndk-apex
put usr/lib/systemd/system/hearth-host-apex.service
put usr/libexec/hearth/host-apex
# Run vndk-apex as a pre-step of the container (the standalone service is
# deleted to break an ordering cycle on this path), and hold greetd until the
# container + host APEX libs are up so labwc doesn't start into a missing
# hwcomposer stack and burn its start limit.
put etc/systemd/system/lxc@android.service.d/hearth-vndk-pre.conf
put etc/systemd/system/greetd.service.d/hearth-wait.conf
put usr/lib/systemd/system/lightdm.service.d/hearth-composer-only.conf
put usr/lib/systemd/system/hearth-wifi-on.service
put usr/libexec/hearth/wifi-on
put usr/lib/NetworkManager/conf.d/hearth-wifi.conf
put usr/lib/systemd/system/hearth-touch-fw.service
put usr/libexec/hearth/touch-fw
put usr/lib/systemd/system/phosh.service.d/hearth-mantel.conf
put usr/libexec/hearth/mantel-session
put usr/libexec/hearth/mantel-shell
put usr/libexec/hearth/mantel-labwc
# The boot-OK check (hearth-boot-fallback clears its try counter through it). It lives in /usr/libexec/hearth,
# which is emptied above at every boot, so it has to come from here too; only on the Hearth (Droidian) rootfs.
if [ -e "$ROOT/usr/lib/systemd/system/phosh.service" ]; then
	put usr/libexec/hearth/boot-ok
	chmod 755 "$ROOT/usr/libexec/hearth/boot-ok"
	put usr/lib/systemd/system/hearth-boot-ok.service
	mkdir -p "$ROOT/usr/lib/systemd/system/graphical.target.wants"
	ln -sf ../hearth-boot-ok.service "$ROOT/usr/lib/systemd/system/graphical.target.wants/hearth-boot-ok.service"
fi
chmod 755 "$ROOT/usr/libexec/hearth" "$ROOT/usr/libexec/hearth/vndk-apex" "$ROOT/usr/libexec/hearth/host-apex" "$ROOT/usr/libexec/hearth/wifi-on" "$ROOT/usr/libexec/hearth/touch-fw" "$ROOT/usr/libexec/hearth/mantel-session" "$ROOT/usr/libexec/hearth/mantel-shell" "$ROOT/usr/libexec/hearth/mantel-labwc"
mkdir -p "$w/lxc-android-config.service.wants"
ln -sf ../hearth-vndk-apex.service "$w/lxc-android-config.service.wants/hearth-vndk-apex.service"
# Droidian starts the container with lxc@android instead.
if [ -f "$w/lxc@.service" ]; then
	mkdir -p "$w/lxc@android.service.wants"
	ln -sf ../hearth-vndk-apex.service "$w/lxc@android.service.wants/hearth-vndk-apex.service"
	ln -sf ../hearth-host-apex.service "$w/lxc@android.service.wants/hearth-host-apex.service"
fi
# Droidian enables Debian's own ssh.service too. It loses the race for port 22
# to hearth-sshd, and as it fails it deletes /run/sshd, which every sshd needs
# for each connection. Mask it there (Ubuntu Touch doesn't enable it).
if [ ! -e "$ROOT/etc/system-image/writable-paths" ] && [ -f "$w/ssh.service" ]; then
	ln -sf /dev/null "$ROOT/etc/systemd/system/ssh.service"
fi
# Mantel (labwc) rotation and scale: the owner chose landscape at 1.25. Created
# once; a value changed on the device is never overwritten.
if [ ! -e "$ROOT/etc/hearth/display" ]; then
	mkdir -p "$ROOT/etc/hearth"
	printf '# Hearth Mantel screen (read by /usr/libexec/hearth/mantel-labwc at session start)\nTRANSFORM=270\nSCALE=1.25\n' > "$ROOT/etc/hearth/display"
	chmod 644 "$ROOT/etc/hearth/display"
fi
# Mantel's display (phoc fallback): phosh's default scale is 3 (phone-sized); the owner chose
# 1.25 and landscape (rotate = 90; phoc's key is "rotate", not "transform").
# Only written when there's no /etc/phosh/phoc.ini yet, so a
# scale changed on the device is never overwritten.
if [ -f "$ROOT/usr/share/phosh/phoc.ini" ] && [ ! -e "$ROOT/etc/phosh/phoc.ini" ]; then
	mkdir -p "$ROOT/etc/phosh"
	{ cat "$ROOT/usr/share/phosh/phoc.ini"; printf '\n[output:HWCOMPOSER-1]\nscale = 1.25\nrotate = 90\n'; } > "$ROOT/etc/phosh/phoc.ini"
	chmod 644 "$ROOT/etc/phosh/phoc.ini"
fi
# Flatpak sandbox: Debian's bubblewrap is installed setuid-root, but this
# build's bwrap is the non-setuid kind and refuses to run that way ("setuid
# use of bubblewrap is not supported"), so every Flatpak app -- Bazaar (the
# app store) included -- dies with "ldconfig failed". The kernel has working
# unprivileged user namespaces (CONFIG_USER_NS=y, max_user_namespaces > 0), so
# clear the setuid bit and let bwrap use the userns path. Idempotent.
[ -u "$ROOT/usr/bin/bwrap" ] && { chmod u-s "$ROOT/usr/bin/bwrap"; say "provision: cleared setuid on bwrap (Flatpak sandbox)"; }

# Minigalaxy (GOG client) installs its launcher at /usr/games/minigalaxy (Debian
# policy for games). The app grid runs it by the bare name "minigalaxy", which
# isn't on the session PATH, so clicking it did nothing. Add a /usr/bin symlink.
[ -x "$ROOT/usr/games/minigalaxy" ] && [ ! -e "$ROOT/usr/bin/minigalaxy" ] && ln -sf /usr/games/minigalaxy "$ROOT/usr/bin/minigalaxy"

# Audio: the four aw883xx speaker amps are native ASoC codecs on backend I2S3 of
# the mt6789-mt6366 card, and Hearth plays through PipeWire. The Droidian base
# instead runs a standalone PulseAudio -- it grabs the card, and the shell (a
# PipeWire client) can't see it, so the on-screen volume does nothing -- and it
# masks PipeWire's own PulseAudio front-end. Flip that: ship the UCM speaker
# profile (hw:0,0 -> I2S3) and the S16LE rule (the path is 16-bit; 32-bit comes
# out as loud static), run pipewire-pulse as the PulseAudio endpoint, keep the
# standalone PulseAudio from starting, and set the DL1->I2S3 route at boot
# (nothing connects the front-end to the amps' I2S otherwise). alsa-ucm-conf must
# be in the image for the UCM profile to load (added in hearth-os build.sh).
put usr/share/alsa/ucm2/conf.d/mt6789-mt6366/mt6789-mt6366.conf
put usr/share/alsa/ucm2/conf.d/mt6789-mt6366/HiFi.conf
put etc/wireplumber/wireplumber.conf.d/51-hearth-rt8-speaker.conf
put etc/pulse/client.conf.d/00-hearth-noautospawn.conf
put usr/lib/systemd/system/hearth-audio-route.service
mkdir -p "$w/multi-user.target.wants"
ln -sf ../hearth-audio-route.service "$w/multi-user.target.wants/hearth-audio-route.service"
# pipewire-pulse on for every user session (Droidian masks it with /dev/null),
# the standalone PulseAudio off.
mkdir -p "$ROOT/etc/systemd/user/sockets.target.wants"
for u in pipewire-pulse.service pipewire-pulse.socket; do
	[ "$(readlink "$ROOT/etc/systemd/user/$u" 2>/dev/null)" = /dev/null ] && rm -f "$ROOT/etc/systemd/user/$u"
done
ln -sf /usr/lib/systemd/user/pipewire-pulse.socket "$ROOT/etc/systemd/user/sockets.target.wants/pipewire-pulse.socket"
ln -sf /dev/null "$ROOT/etc/systemd/user/pulseaudio.service"
ln -sf /dev/null "$ROOT/etc/systemd/user/pulseaudio.socket"

# An earlier build left this here; the container never picked it up.
rm -f "$ROOT/var/lib/lxc/android/overrides/init.mt8781.rc"

# Bind our two Android init files over the system image's copies inside the
# container. lxc applies mount entries after it has set up the rootfs and
# before Android's init starts. The system image itself stays untouched and
# read-only; "optional" means a missing file can never stop the container.
cfg="$ROOT/var/lib/lxc/android/config"
if [ -f "$cfg" ]; then
	# Replace our block if a previous build added one (never add it twice).
	sed -i '/^# hearth-begin$/,/^# hearth-end$/d' "$cfg" 2>/dev/null
	grep -q '^# hearth-begin$' "$cfg" || cat >> "$cfg" <<'LXC'
# hearth-begin
lxc.mount.entry = /usr/share/hearth/android/vold.rc system/etc/init/vold.rc none bind,ro,optional 0 0
lxc.mount.entry = /usr/share/hearth/android/vndservicemanager.rc vendor/etc/init/vndservicemanager.rc none bind,ro,optional 0 0
lxc.mount.entry = /usr/share/hearth/android/init.boringssl.zygote64_32.rc system/etc/init/hw/init.boringssl.zygote64_32.rc none bind,ro,optional 0 0
lxc.mount.entry = /usr/lib/hearth-modules vendor_dlkm/lib/modules none bind,ro,optional 0 0
lxc.mount.entry = /run/hearth/apexd.rc system/etc/init/apexd.rc none bind,ro,optional 0 0
lxc.mount.entry = /run/hearth/system-apex system/apex none bind,ro,optional 0 0
# hearth-end
LXC
	say "provision: Android init overrides added to the container config"
else
	say "provision: $cfg missing, Android overrides not added"
fi
# Our kernel's modules, for the Android container. Android's init loads
# Wi-Fi/Bluetooth/GPS drivers itself with "insmod /vendor/lib/modules/X.ko"
# (a link to /vendor_dlkm/lib/modules), i.e. Oukitel's builds, which our
# kernel rejects. Copy the boot image's modules (built with this kernel)
# into the rootfs and bind them over vendor_dlkm/lib/modules in the
# container. Only copy when they changed, to spare the flash.
MODSRC=/lib/modules
MODDST="$ROOT/usr/lib/hearth-modules"
if [ -f "$MODSRC/modules.dep" ]; then
	# modules.dep lists every built module, not just the ones packed, so
	# compare the packed file list and sizes instead.
	stamp="$(uname -r) $(ls -ln "$MODSRC" | md5sum)"
	if [ "$stamp" != "$(cat "$MODDST/.hearth-stamp" 2>/dev/null)" ]; then
		rm -rf "$MODDST.new"
		mkdir -p "$MODDST.new"
		if cp "$MODSRC"/*.ko "$MODSRC"/modules.* "$MODDST.new"/ 2>/dev/null; then
			rm -rf "$MODDST"
			echo "$stamp" > "$MODDST.new/.hearth-stamp"
			mv "$MODDST.new" "$MODDST"
			chmod 755 "$MODDST"
			say "provision: kernel modules copied for the Android container ($(ls "$MODDST" | wc -l) files)"
		else
			rm -rf "$MODDST.new"
			say "provision: copying kernel modules failed (rootfs full?)"
		fi
	fi
fi

# Saved Wi-Fi networks: a fresh rootfs (the Hearth image) starts with none, so
# give it the NetworkManager keyfiles kept in /userdata/hearth-nm (copied
# there once from Ubuntu Touch, which only generates them in /run from
# netplan), for SSH over Wi-Fi from the first boot. Only fills an empty
# directory; never overwrites what a system saved itself.
NMSRC="$ROOT/userdata/hearth-nm"
NMDST="$ROOT/etc/NetworkManager/system-connections"
# (Not into Ubuntu Touch itself, which has its own netplan setup.)
if [ ! -e "$ROOT/etc/system-image/writable-paths" ] && [ -d "$NMSRC" ] && [ -d "$ROOT/etc/NetworkManager" ] && [ -z "$(ls -A "$NMDST" 2>/dev/null)" ]; then
	mkdir -p "$NMDST"
	for f in "$NMSRC"/*; do
		[ -f "$f" ] || continue
		# Ubuntu Touch's netplan pins these to its own interface name (ap0);
		# drop that so NetworkManager uses them on whatever interface exists.
		grep -v '^interface-name=' "$f" > "$NMDST/$(basename "$f")"
		chown 0:0 "$NMDST/$(basename "$f")"
		chmod 600 "$NMDST/$(basename "$f")"
	done
	say "provision: copied saved Wi-Fi networks ($(ls "$NMDST" | wc -l))"
fi

mkdir -p "$w/multi-user.target.wants"
ln -sf ../hearth-sshd.service "$w/multi-user.target.wants/hearth-sshd.service"
ln -sf ../hearth-wifi-on.service "$w/multi-user.target.wants/hearth-wifi-on.service"
ln -sf ../hearth-touch-fw.service "$w/multi-user.target.wants/hearth-touch-fw.service"

if [ -x "$ROOT/usr/sbin/sshd" ]; then
	say "provision: key-only root SSH installed"
else
	say "provision: installed, but $ROOT/usr/sbin/sshd is missing"
fi
sync
[ -n "$was_ro" ] && mount -o remount,ro "$ROOT"
exit 0
