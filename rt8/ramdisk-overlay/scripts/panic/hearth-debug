#!/bin/sh
# Hearth OS RT8 bring-up helper (debug builds only).
#
# Runs when the Halium initramfs gives up (no Hearth rootfs yet) just before
# the telnet debug shell starts. In the background it:
#   1. logs the USB device-mode state into the kernel log, and
#   2. if USB still isn't attached after HEARTH_DEBUG_REBOOT seconds, saves
#      the whole kernel log to flash: the last 16 MiB of the expdb partition
#      (MediaTek's crash-log partition; LK only uses its start). Read it from
#      the PC at any time afterwards, no timing needed:
#        mtk.py r expdb rt8-expdb.bin
#      The log starts with the marker "HEARTH-DMESG-BEGIN".
#      (Reading pstore from RAM after a reset proved unreliable on the RT8.)
#   If USB comes up it exits and leaves the telnet shell alone.

PREREQ=""
prereqs() { echo "$PREREQ"; }
case $1 in prereqs) prereqs; exit 0 ;; esac

HEARTH_DEBUG_REBOOT=90

log() { echo "hearth-debug: $*" > /dev/kmsg; }
show() {
	for f in "$@"; do
		[ -e "$f" ] || continue
		log "$f = $(cat "$f" 2>/dev/null | tr '\n' ' ')"
	done
}

(
	sleep 20
	log "---- USB state, 20s after Halium panic ----"
	log "udc: $(ls /sys/class/udc 2>/dev/null | tr '\n' ' ')"
	show /config/usb_gadget/g1/UDC /sys/class/udc/*/state /sys/class/udc/*/current_speed
	log "net: $(ls /sys/class/net 2>/dev/null | tr '\n' ' ')"
	log "tcpc: $(ls /sys/class/tcpc 2>/dev/null | tr '\n' ' ')"
	show /sys/class/typec/*/data_role /sys/class/typec/*/power_role
	show /sys/class/power_supply/*/online /sys/class/power_supply/*/type
	show /sys/class/power_supply/*/usb_type /sys/class/power_supply/*/chr_type
	log "modules: $(cut -d' ' -f1 /proc/modules | grep -iE 'musb|usb|udc|tcpc|aw35|typec|phy' | tr '\n' ' ')"
	# Only crash if USB never came up: with a working USB link the telnet
	# shell is the better debugging tool, so leave it alone.
	waited=20
	while [ $waited -lt $HEARTH_DEBUG_REBOOT ]; do
		if grep -qvx 'not attached' /sys/class/udc/musb-hdrc/state 2>/dev/null; then
			log "USB is up ($(cat /sys/class/udc/musb-hdrc/state)) - use telnet 192.168.2.15; not crashing"
			exit 0
		fi
		sleep 5
		waited=$((waited + 5))
	done
	log "---- USB still not attached after ${HEARTH_DEBUG_REBOOT}s; saving the kernel log to expdb ----"
	show /config/usb_gadget/g1/UDC /sys/class/udc/*/state
	log "net: $(ls /sys/class/net 2>/dev/null | tr '\n' ' ')"

	dev=""
	for u in /sys/class/block/*/uevent; do
		if grep -qx 'PARTNAME=expdb' "$u" 2>/dev/null; then
			dev=/dev/$(grep '^DEVNAME=' "$u" | cut -d= -f2)
			break
		fi
	done
	if [ -z "$dev" ] || [ ! -b "$dev" ]; then
		log "no expdb block device found, cannot save the log"
		exit 0
	fi
	size=$(cat /sys/class/block/$(basename "$dev")/size)	# 512-byte sectors
	off=$(( size / 2048 - 16 ))				# MiB: last 16 MiB
	{
		echo "HEARTH-DMESG-BEGIN $(date) uptime=$(cut -d' ' -f1 /proc/uptime)"
		dmesg
		echo "HEARTH-DMESG-END"
	} > /run/hearth-dmesg.txt
	head -c 16777216 /run/hearth-dmesg.txt > /run/hearth-dmesg.cut
	dd if=/dev/zero of="$dev" bs=1048576 seek=$off count=16 conv=notrunc 2>/dev/null
	dd if=/run/hearth-dmesg.cut of="$dev" bs=1048576 seek=$off conv=notrunc 2>/dev/null
	sync
	log "saved $(wc -c < /run/hearth-dmesg.cut) bytes of kernel log to $dev at ${off} MiB - safe to power off and read expdb"
) &
