#!/bin/sh
# Hearth (RT8) bring-up: install a key-only root SSH service from
# /hearth-provision into the rootfs image on userdata before it boots.
# The UBports test image only enables SSH through an Upstart file, which
# systemd (24.04) ignores. Ubuntu Touch's own USB tethering provides the
# network (tablet at 10.15.19.82). Never fails the boot.
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in prereqs) prereqs; exit 0;; esac

say() { echo "hearth: $*" > /dev/kmsg; }
SRC=/hearth-provision
DATA=/hearth-data
ROOT=/hearth-root

say "provision: start"
[ -d "$SRC" ] || { say "provision: $SRC missing"; exit 0; }
part=/dev/disk/by-partlabel/userdata
[ -e "$part" ] || { say "provision: no userdata"; exit 0; }

mkdir -p "$DATA" "$ROOT"
mount -t ext4 "$part" "$DATA" 2>/dev/null || { say "provision: cannot mount userdata"; exit 0; }
img=""
for f in ubuntu.img rootfs.img; do
	[ -f "$DATA/$f" ] && { img="$DATA/$f"; break; }
done
if [ -n "$img" ] && mount -o loop,rw "$img" "$ROOT" 2>/dev/null; then
	w="$ROOT/usr/lib/systemd/system"
	# Remove the earlier unauthenticated shell and USB-network service if a
	# previous build installed them.
	rm -f "$w/hearth-usbnet.service" "$w/hearth-shell.socket" "$w/hearth-shell@.service" \
		"$w/multi-user.target.wants/hearth-usbnet.service" \
		"$w/sockets.target.wants/hearth-shell.socket"
	rm -rf "$ROOT/usr/libexec/hearth"

	cp -a "$SRC/." "$ROOT/"
	# The ramdisk overlay is packed with the build user's IDs; sshd also
	# refuses key files that aren't root-owned and non-writable.
	chown 0:0 "$w/hearth-sshd.service"
	chown -R 0:0 "$ROOT/usr/share/hearth"
	chmod 755 "$ROOT/usr/share/hearth"
	chmod 644 "$ROOT/usr/share/hearth/authorized_keys" "$w/hearth-sshd.service"
	mkdir -p "$w/multi-user.target.wants"
	ln -sf ../hearth-sshd.service "$w/multi-user.target.wants/hearth-sshd.service"
	sync
	umount "$ROOT"
	say "provision: key-only root SSH installed into ${img##*/}"
else
	say "provision: no rootfs image to update"
fi
umount "$DATA"
exit 0
