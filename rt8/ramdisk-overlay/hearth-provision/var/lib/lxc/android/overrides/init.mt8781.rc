# Hearth (RT8): copied into the Android container's root by lxc-android
# (pre-start.d/25-process-overrides) and imported by init.rc as
# /init.${ro.hardware}.rc. It is parsed before the APEX init files, so these
# definitions win over the real ones.
#
# The BoringSSL self-tests from the conscrypt APEX fail inside the Halium
# container (APEX setup is partial there) and are marked reboot_on_failure,
# which rebooted the whole tablet about a minute into every boot. Replace
# them with no-ops.
service boringssl_self_test_apex32 /system/bin/true
    class main
    user root
    oneshot
    disabled

service boringssl_self_test_apex64 /system/bin/true
    class main
    user root
    oneshot
    disabled
