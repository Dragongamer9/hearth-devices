#!/bin/sh
# Hearth (RT8) debug USB networking: an RNDIS gadget on 192.168.2.15 with a
# small DHCP server, re-asserted if something (e.g. Android's init) unbinds it.
G=/sys/kernel/config/usb_gadget/hearth
IP=192.168.2.15

mountpoint -q /sys/kernel/config || mount -t configfs none /sys/kernel/config

setup() {
	[ -d "$G/configs/c.1/rndis.usb0" ] && return 0
	mkdir -p "$G" || return 1
	echo 0x18d1 > "$G/idVendor"
	echo 0xd001 > "$G/idProduct"
	mkdir -p "$G/strings/0x409"
	echo "Hearth" > "$G/strings/0x409/manufacturer"
	echo "Hearth RT8 (Ubuntu Touch test)" > "$G/strings/0x409/product"
	echo "hearth-rt8" > "$G/strings/0x409/serialnumber"
	mkdir -p "$G/functions/rndis.usb0" "$G/configs/c.1/strings/0x409"
	echo "RNDIS" > "$G/configs/c.1/strings/0x409/configuration"
	ln -s "$G/functions/rndis.usb0" "$G/configs/c.1/" 2>/dev/null
	return 0
}

bind() {
	# The real port is musb-hdrc; never use a dummy_udc test controller.
	udc=$(ls /sys/class/udc 2>/dev/null | grep -v dummy | grep musb | head -1)
	[ -n "$udc" ] || udc=$(ls /sys/class/udc 2>/dev/null | grep -v dummy | head -1)
	[ -n "$udc" ] || return 1
	[ "$(cat "$G/UDC" 2>/dev/null)" = "$udc" ] && return 0
	for u in /sys/kernel/config/usb_gadget/*/UDC; do
		[ "$u" = "$G/UDC" ] || echo "" > "$u" 2>/dev/null
	done
	echo "$udc" > "$G/UDC"
}

ifup() {
	ip link set usb0 up 2>/dev/null || return 1
	ip addr show usb0 | grep -q "$IP/" || ip addr add "$IP/24" dev usb0
	if ! pgrep -f 'dnsmasq.*hearth-usb' >/dev/null && command -v dnsmasq >/dev/null; then
		dnsmasq --conf-file=/dev/null --pid-file= --interface=usb0 --bind-dynamic \
			--dhcp-range=192.168.2.20,192.168.2.30,12h --port=0 \
			--dhcp-leasefile=/run/hearth-usb.leases &
	fi
}

while :; do
	setup && bind && ifup
	sleep 10
done
