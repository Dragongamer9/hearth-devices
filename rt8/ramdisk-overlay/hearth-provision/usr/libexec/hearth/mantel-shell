#!/bin/bash -l
# The login profile (-l) supplies Droidian's LD_PRELOAD (libtls-padding.so
# and friends). Without it the Mali driver, loaded through libhybris,
# crashes on the bionic/glibc thread-local-storage clash.
shell=
for d in /usr/share/hearth/shell /userdata/hearth-src/hearth-os/hosts/linux/desktop/shell; do
	[ -f "$d/shell.qml" ] && { shell=$d; break; }
done
if [ "$1" = --path ]; then echo "$shell"; exit 0; fi
# Render the shell on the CPU (Qt's software backend) into wl_shm buffers that
# labwc composites. The panel's Mali EGL is an Android EGL and can't hand a Qt
# Wayland *client* a GPU surface -- quickshell's every frame fails with "Cannot
# find EGLConfig" / EGL_BAD_CONFIG and the screen stays black. Software
# rendering sidesteps that; a 2D shell draws fine this way. (GPU acceleration
# for Wayland clients on this panel is future work.)
# QSG_RENDER_LOOP=basic: Qt's threaded loop stalls for good under libhybris EGL
# (picture freezes after a minute); the basic loop renders on the GUI thread.
export QT_QUICK_BACKEND=software QSG_RENDER_LOOP=basic EGL_PLATFORM=wayland QT_QPA_PLATFORM=wayland XDG_CURRENT_DESKTOP=Hearth XDG_SESSION_DESKTOP=hearth
# Droidian's profile hides Qt title bars (phone style); Mantel windows have them.
unset QT_WAYLAND_DISABLE_WINDOWDECORATION WLR_BACKENDS WLR_HWC_SKIP_VERSION_CHECK DISPLAY
exec /opt/quickshell/bin/quickshell -p "$shell"
