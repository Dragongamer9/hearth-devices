diff --git a/drivers/power/supply/sc8960x_charger.c b/drivers/power/supply/sc8960x_charger.c
index 9623cc021..affeca599 100644
--- a/drivers/power/supply/sc8960x_charger.c
+++ b/drivers/power/supply/sc8960x_charger.c
@@ -2092,6 +2092,17 @@ static struct of_device_id sc8960x_charger_match_table[] = {
 	 .compatible = "sc,sc89601d",
 	 .data = &pn_data[PN_SC89601D],
 	 },
+	/*
+	 * Hearth OS (RT8): Oukitel's device tree names the same chip
+	 * "sc,sc89601d_charger" (that is what its stock driver matches).
+	 * Without it the primary charger never registers, the MTK charger
+	 * framework never reports a USB host, and the USB port never enters
+	 * device mode.
+	 */
+	{
+	 .compatible = "sc,sc89601d_charger",
+	 .data = &pn_data[PN_SC89601D],
+	 },
 	{},
 };
 MODULE_DEVICE_TABLE(of, sc8960x_charger_match_table);
