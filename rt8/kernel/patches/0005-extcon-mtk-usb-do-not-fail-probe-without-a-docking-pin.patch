@@ -1336,6 +1340,7 @@ static int mtk_usb_extcon_probe(struct platform_device *pdev)
 	}
 
 
+skip_docking:
 	docking_extcon = extcon;
 #endif
 	platform_set_drvdata(pdev, extcon);
